# ──────────────────────────────────────────────────────────
# All-in-One Image: API + SMTP + Workers + Web
# Requires external PostgreSQL and Redis (provide via env / .env file)
# ──────────────────────────────────────────────────────────
# Build:  docker build -f Dockerfile.allinone --platform linux/amd64 -t mailpocket .
# Run:    docker run -d -p 3000:3000 -p 3002:3002 -p 2525:2525 -p 1025:1025 --env-file .env mailpocket
# ──────────────────────────────────────────────────────────

# ─── Stage 1: Build app ──────────────────────────────────
FROM node:22-bookworm-slim AS build
RUN corepack enable && corepack prepare pnpm@latest --activate
WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY packages/env/package.json packages/env/
COPY packages/db/package.json packages/db/
COPY packages/queue/package.json packages/queue/
COPY packages/storage/package.json packages/storage/
COPY apps/api/package.json apps/api/
COPY apps/smtp/package.json apps/smtp/
COPY apps/workers/package.json apps/workers/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

COPY . .
RUN pnpm build

# ─── Stage 2: Runtime ────────────────────────────────────
FROM node:22-alpine

RUN apk add --no-cache supervisor && \
    corepack enable && corepack prepare pnpm@latest --activate

# Copy built application
WORKDIR /app
COPY --from=build /app .

# Copy environment variables template (users should provide their own .env file in production)
COPY .env.example .env

# Copy config files
COPY docker/supervisord.conf /etc/supervisord.conf
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Expose ports: Web, API, SMTP
EXPOSE 3000 3002 2525 1025

ENTRYPOINT ["/entrypoint.sh"]
