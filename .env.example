# ─── PostgreSQL ─────────────────────────────────────────────
# In all-in-one mode DATABASE_URL is auto-constructed from PG_* vars below.
# Set these to match your desired credentials:
PG_USER=smtp
PG_PASSWORD=smtp_password
PG_DB=smtp_service
# DATABASE_URL is used directly in non-allinone (external DB) deployments:
DATABASE_URL=postgresql://smtp:smtp_password@localhost:5432/smtp_service

# ─── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=Admin@123456

# Local filesystem (default in all-in-one)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=data/

# ─── MinIO (S3-compatible storage) ─────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=emails
MINIO_USE_SSL=false

# ─── SMTP Server ──────────────────────────────────────────
NUXT_PUBLIC_SMTP_HOST=localhost      # Advertised/external hostname or IP (what users are told to connect to)
NUXT_PUBLIC_SMTP_PORT=2525
SMTP_BIND_HOST=0.0.0.0   # Local bind address (use 0.0.0.0 in containers/K8s)
# SMTP_PORT_ALT=1025    # alternate SMTP port (docker-compose host binding)
# SMTP_PORTS=2525,1025  # comma-separated ports the SMTP server listens on

# ─── API Server ───────────────────────────────────────────
API_PORT=3002
API_HOST=0.0.0.0

# ─── Web Frontend ─────────────────────────────────────────
WEB_PORT=3000                          # host port for the web container / dev server
NUXT_API_TARGET=http://localhost:3002  # proxy target for the Nuxt reverse proxy

# ─── Infrastructure host ports (docker-compose) ───────────
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# MINIO_PORT=9000
# MINIO_CONSOLE_PORT=9001

# ─── App Mode ─────────────────────────────────────────────
# "testing" = sinkhole (captures all mail, no real delivery)
# "production" = relay (delivers to real recipients via MX lookup)
APP_MODE=testing

# ─── Auth ──────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-16-chars

# ─── OAuth2 PKCE (optional) ───────────────────────────────
OAUTH2_ENABLED=false
# OAUTH2_ISSUER_URL=https://accounts.google.com
# OAUTH2_CLIENT_ID=your-client-id
# OAUTH2_REDIRECT_URI=http://localhost:3000/auth/callback
# OAUTH2_SCOPES=openid profile email

# ─── LDAP (optional) ──────────────────────────────────────
LDAP_ENABLED=false
# LDAP_URL=ldap://localhost:389
# LDAP_BIND_DN=cn=admin,dc=example,dc=com
# LDAP_BIND_PASSWORD=admin_password
# LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER="(|(sAMAccountName={{username}})(userPrincipalName={{username}}))"

# ─── Tracking ─────────────────────────────────────────────
TRACKING_BASE_URL=http://localhost:3001

# ─── Cleanup ──────────────────────────────────────────────
CLEANUP_MAX_AGE_HOURS=24
# CLEANUP_BATCH_SIZE=

# ─── Admin Seed (for db:seed script) ─────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
